# Copy to .env. Never commit .env.
BASE_URL=http://localhost:8000/
PUBLICATION_URL=https://awfulwoman.com/
# 32+ random characters:   openssl rand -hex 32
SECRET=
# argon2id hash of the sign-in password:
#   docker compose run --rm -T micropub-server hash-password <<< 'your password'
PASSWORD_HASH=
# Production only (GitHub store): fine-grained token with Contents read and write
GITHUB_TOKEN=
